APP_NAME=KuluApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kuluapp
DB_USERNAME=kuluapp_user
DB_PASSWORD=CHANGE_ME

# Admin allow-list (server-side only — never trust client role)
# Primary admin (Google account email, verified)
ADMIN_EMAIL=you@gmail.com
# Optional additional admins (comma-separated)
ADMIN_EMAILS=

FIREBASE_CREDENTIALS=/home/USERNAME/kulu_core/storage/firebase/service-account.json

CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxx

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

FILESYSTEM_DISK=public
SANCTUM_STATEFUL_DOMAINS=
